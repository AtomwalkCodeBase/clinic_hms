DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Registry DB (shared across all tenants)
REGISTRY_DB_NAME=atomwalk_registry
REGISTRY_DB_USER=postgres
REGISTRY_DB_PASSWORD=password
REGISTRY_DB_HOST=localhost
REGISTRY_DB_PORT=5432

# Tenant DBs use the same host/user/password — each gets its own DB name
TENANT_DB_USER=postgres
TENANT_DB_PASSWORD=password
TENANT_DB_HOST=localhost
TENANT_DB_PORT=5432

# Redis (Celery broker)
REDIS_URL=redis://localhost:6379/0

# JWT
# JWT_SIGNING_KEY must be a separate secret from SECRET_KEY (never reuse it) —
# SECRET_KEY also backs Django sessions/CSRF/password-reset tokens, so sharing
# it means a leak of either compromises both, and neither can be rotated
# independently. Required in production; falls back to SECRET_KEY only when
# DEBUG=True so local dev doesn't need to set a second value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=your-separate-jwt-signing-key-here-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (core/email.py) — required for OTP delivery once DEBUG=False
# (DEBUG defaults to the console backend, which just prints to the server
# log — no credentials needed for local dev). Any SMTP account works;
# Gmail/Google Workspace shown here using an app password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-address@yourdomain.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Atomwalk HMS <your-address@yourdomain.com>

# SMS (core/sms.py) — "log" (default) just logs the OTP instead of texting
# it. Set SMS_BACKEND=msg91 to send real texts via MSG91 — requires a DLT-
# approved template already created on your MSG91 dashboard (mandatory for
# Indian transactional SMS); MSG91_TEMPLATE_ID is that template's ID, and
# MSG91_OTP_VAR_NAME must match the variable name used inside it.
SMS_BACKEND=log
MSG91_AUTH_KEY=your-msg91-authkey
MSG91_TEMPLATE_ID=your-dlt-approved-template-id
MSG91_OTP_VAR_NAME=VAR1

# SMS via self-hosted Android phone+SIM instead of a paid aggregator — set
# SMS_BACKEND=android_gateway and install "SMS Gateway for Android"
# (github.com/capcom6/android-sms-gateway) on a phone with a SIM. Username/
# password are shown on the app's Home screen. BASE_URL is the phone's own
# address in Local mode (same network as this server required) or your
# Private/Cloud server URL — see docs.sms-gate.app/getting-started. TRAI/
# DLT registration for transactional SMS in India still applies regardless
# of which gateway sends it.
SMS_GATEWAY_BASE_URL=http://192.168.1.50:8080
SMS_GATEWAY_USERNAME=your-gateway-username
SMS_GATEWAY_PASSWORD=your-gateway-password

# Optional one-hop fallback — tried automatically if SMS_BACKEND's actual
# send attempt fails (e.g. the gateway phone goes offline mid-flight).
# Leave blank to disable. Example: SMS_BACKEND=android_gateway +
# SMS_FALLBACK_BACKEND=msg91.
SMS_FALLBACK_BACKEND=

# OTP (core/otp.py) — separate secret from JWT_SIGNING_KEY so it can be
# rotated independently. Required in production; falls back to
# JWT_SIGNING_KEY only when DEBUG=True.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
OTP_HASH_PEPPER=your-separate-otp-hash-pepper-here-change-in-production

# Atomwalk Platform Admin secret (for provisioning endpoint)
PLATFORM_ADMIN_SECRET=change-this-secret

# Handwriting recognition for the consult-pad QR (apps/patients/consult_pad_recognition.py).
# Any OpenAI-compatible vision chat endpoint. LEAVE KEY BLANK to disable (PDF still saves,
# doctor types the note). Examples:
#   OpenAI    : BASE=https://api.openai.com/v1       MODEL=gpt-4o-mini
#   Groq      : BASE=https://api.groq.com/openai/v1  MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   OpenRouter: BASE=https://openrouter.ai/api/v1    MODEL=google/gemini-2.0-flash-001
CONSULT_PAD_LLM_BASE=https://api.groq.com/openai/v1
CONSULT_PAD_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CONSULT_PAD_LLM_KEY=

# ── My Reports: document classification & QR ────────────────────────────────
# HMAC secret for the QR printed on prescriptions / lab reports (core/qr_token.py).
# Recommended in production so it can be rotated independently of SECRET_KEY.
# If blank, SECRET_KEY is used. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOC_QR_SECRET=
# OCR for classifying no-QR uploads (external lab/hospital docs). Needs the
# `tesseract-ocr` SYSTEM package on the host (Debian/Ubuntu: apt-get install -y
# tesseract-ocr). If it is not installed, uploads still work — unrecognised
# files just land in the patient's Unsorted tray for a one-tap fix.
