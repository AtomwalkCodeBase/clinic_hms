DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Atomwalk DB (shared across all hospitals)
ATOMWALK_DB_NAME=chms_prod
ATOMWALK_DB_USER=postgres
ATOMWALK_DB_PASSWORD=password
ATOMWALK_DB_HOST=localhost
ATOMWALK_DB_PORT=5432

# Hospital DBs use the same host/user/password — each gets its own DB name
HOSPITAL_DB_USER=postgres
HOSPITAL_DB_PASSWORD=password
HOSPITAL_DB_HOST=localhost
HOSPITAL_DB_PORT=5432

# Redis / Celery (apps/records document pipeline). The broker and result backend can be the same Redis.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Run tasks inline (no worker needed) — for local experiments only
CELERY_TASK_ALWAYS_EAGER=False

# JWT
# JWT_SIGNING_KEY must be a separate secret from SECRET_KEY (never reuse it) —
# SECRET_KEY also backs Django sessions/CSRF/password-reset tokens, so sharing
# it means a leak of either compromises both, and neither can be rotated
# independently. Required in production; falls back to SECRET_KEY only when
# DEBUG=True so local dev doesn't need to set a second value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SIGNING_KEY=your-separate-jwt-signing-key-here-change-in-production
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (core/messaging/email.py) — required for OTP delivery once DEBUG=False
# (DEBUG defaults to the console backend, which just prints to the server
# log — no credentials needed for local dev). Any SMTP account works;
# Gmail/Google Workspace shown here using an app password.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-address@yourdomain.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Atomwalk HMS <your-address@yourdomain.com>

# SMS (core/messaging/sms.py) — "log" (default) just logs the OTP instead of texting
# it. Set SMS_BACKEND=msg91 to send real texts via MSG91 — requires a DLT-
# approved template already created on your MSG91 dashboard (mandatory for
# Indian transactional SMS); MSG91_TEMPLATE_ID is that template's ID, and
# MSG91_OTP_VAR_NAME must match the variable name used inside it.
SMS_BACKEND=log
MSG91_AUTH_KEY=your-msg91-authkey
MSG91_TEMPLATE_ID=your-dlt-approved-template-id
MSG91_OTP_VAR_NAME=VAR1

# SMS via self-hosted Android phone+SIM instead of a paid aggregator — set
# SMS_BACKEND=android_gateway and install "SMS Gateway for Android"
# (github.com/capcom6/android-sms-gateway) on a phone with a SIM. Username/
# password are shown on the app's Home screen. BASE_URL is the phone's own
# address in Local mode (same network as this server required) or your
# Private/Cloud server URL — see docs.sms-gate.app/getting-started. TRAI/
# DLT registration for transactional SMS in India still applies regardless
# of which gateway sends it.
SMS_GATEWAY_BASE_URL=http://192.168.1.50:8080
SMS_GATEWAY_USERNAME=your-gateway-username
SMS_GATEWAY_PASSWORD=your-gateway-password

# Optional one-hop fallback — tried automatically if SMS_BACKEND's actual
# send attempt fails (e.g. the gateway phone goes offline mid-flight).
# Leave blank to disable. Example: SMS_BACKEND=android_gateway +
# SMS_FALLBACK_BACKEND=msg91.
SMS_FALLBACK_BACKEND=

# OTP (core/messaging/otp.py) — separate secret from JWT_SIGNING_KEY so it can be
# rotated independently. Required in production; falls back to
# JWT_SIGNING_KEY only when DEBUG=True.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
OTP_HASH_PEPPER=your-separate-otp-hash-pepper-here-change-in-production

# Handwriting recognition for the consult-pad QR (apps/hospital_patients/consult_pad_recognition.py).
# Any OpenAI-compatible vision chat endpoint. LEAVE KEY BLANK to disable (PDF still saves,
# doctor types the note). Examples:
#   OpenAI    : BASE=https://api.openai.com/v1       MODEL=gpt-4o-mini
#   Groq      : BASE=https://api.groq.com/openai/v1  MODEL=meta-llama/llama-4-scout-17b-16e-instruct
#   OpenRouter: BASE=https://openrouter.ai/api/v1    MODEL=google/gemini-2.0-flash-001
CONSULT_PAD_LLM_BASE=https://api.groq.com/openai/v1
CONSULT_PAD_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CONSULT_PAD_LLM_KEY=

# ── My Reports: document classification & QR ────────────────────────────────
# HMAC secret for the QR printed on prescriptions / lab reports (core/utils/qr_token.py).
# Recommended in production so it can be rotated independently of SECRET_KEY.
# If blank, SECRET_KEY is used. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DOC_QR_SECRET=
# OCR is RapidOCR only (pip: rapidocr-onnxruntime, no system package); there is nothing to configure.
# GROQ_API_KEY (if set) is used as CONSULT_PAD_LLM_KEY when that is blank
GROQ_API_KEY=

# apps/records: all sweep settings (instant-upload limit, dispatch limit, interval) are now
# Platform Admin-editable at runtime — see apps.records.models.SweepConfig. No env vars here.

# Upload size — the single-file "attach a report" endpoint takes a base64
# JSON body, so the whole request must fit under this. Default 20 MB allows
# an ~11 MB photo (base64 inflates ~4/3). The reverse proxy (nginx
# client_max_body_size) must be at least as large or the request is rejected
# with 413 before it reaches Django.
DATA_UPLOAD_MAX_MEMORY_SIZE=20971520

# ── Object storage (S3) — every uploaded file (photos, logos, reports, documents) ─────────
# The bucket must be PRIVATE; files are served through short-lived presigned URLs.
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_URL_EXPIRY=3600

# ── Deployment (core.settings.production, DEBUG=False) ───────────────────────────────
# Also required when DEBUG=False: SECRET_KEY, JWT_SIGNING_KEY, OTP_HASH_PEPPER (above).
# ALLOWED_HOSTS=app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
# SECURE_SSL_REDIRECT=True
# FRONTEND_URL=https://app.example.com     # encoded into QR codes (consult pad, share links)
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
# ENVIRONMENT=production

# Pediatric health timeline - the LLM; the one place to switch between the company api and a local Ollama
LLM_API_STYLE=company
LLM_API_URL=https://atomwalk.com/llm_api/ask/
LLM_API_TOKEN=
# local testing instead:
# LLM_API_STYLE=ollama
# LLM_API_URL=http://localhost:11434/api/chat
# LLM_API_MODEL=qwen2.5-coder:7b
# An OpenAI-compatible api (Groq, xAI Grok, OpenAI): the key goes in LLM_API_TOKEN
# LLM_API_STYLE=openai
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_API_MODEL=openai/gpt-oss-120b

# ── Production: these have NO fallback, the app refuses to start without them ──
# ENVIRONMENT=production
# ALLOWED_HOSTS=app.example.com
# ATOMWALK_DB_USER / ATOMWALK_DB_PASSWORD / ATOMWALK_DB_HOST, HOSPITAL_DB_USER / HOSPITAL_DB_PASSWORD / HOSPITAL_DB_HOST
# CORS_ALLOWED_ORIGINS=https://app.example.com    (the only sites allowed to call the API)

# Third-party endpoints (no built-in URL; set the ones you use)
MSG91_FLOW_URL=https://control.msg91.com/api/v5/flow
# LLM_API_URL=         (see the LLM block above)

# Locale and clinic rules (defaults shown)
TIME_ZONE=Asia/Kolkata
DEFAULT_COUNTRY_CODE=+91
MOBILE_NUMBER_LENGTH=10
CURRENCY_SYMBOL=₹
BOOKING_WINDOW_DAYS=62
NO_SHOW_GRACE_HOURS=2
DEFAULT_SLOT_MINUTES=15
DEFAULT_CLINIC_HOURS=9-13,14-18
CONSULT_PAD_EXPIRY_HOURS=12
BILLING_REPORT_DAYS=30
HOSPITAL_DB_PREFIX=cp_
S3_KEY_PREFIX=media-prod
