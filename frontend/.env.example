# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real values.

# Django backend URL
VITE_API_BASE_URL=http://localhost:8000

# Shown on login and error pages (optional; the support phone is hidden when empty)
VITE_COMPANY_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_LOCALE=en-IN
VITE_CURRENCY=INR
