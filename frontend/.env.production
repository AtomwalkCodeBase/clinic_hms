# Picked up automatically by `npm run build` (Vite loads .env.production for
# production builds, .env.development / .env.local for `npm run dev`).
#
# This must point at your real, publicly reachable API domain — the one
# ALLOWED_HOSTS and CORS_ALLOWED_ORIGINS on the Django side are configured
# to accept. Replace before building for deployment.
VITE_API_BASE_URL=https://api.yourdomain.com
