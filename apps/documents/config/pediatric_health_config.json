  "patient_labels": {
    "_doc": "Gentle wording for the guardian app. Doctor view uses the raw codes.",
    "CRITICAL": "Hospital care needed",
    "CRITICAL_LAB": "Result needed doctor's attention",
    "ABNORMAL": "Outside usual range",
    "RECURRENT": "Happens often",
    "CHRONIC": "Ongoing condition",
    "ACUTE": "Short illness",
    "OVERDUE": "Overdue",
    "DUE": "Due now",
    "UPCOMING": "Coming up",
    "GIVEN": "Given"
  },
  "timeline_labels": {
    "_note": "A condition's row label is its diagnosis cut at the first of these separators, then at most max_length characters. The full text and codes stay as the hover text.",
    "cut_at": [" - ", " – ", " — ", " with ", " due to ", " secondary to ", " following ", " after ", " (", ",", ";", ":"],
    "max_length": 34
  }
