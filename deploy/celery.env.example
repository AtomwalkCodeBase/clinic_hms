# /etc/hms/celery.env — process tunables for the HMS systemd services.
# (App settings — DB, broker URL, LLM keys — stay in the app's .env.)
# After editing:  sudo systemctl restart hms-celery-worker hms-celery-llm hms-celery-beat hms-flower

# Worker: parallel tasks. Each OCR task can use ~300-500 MB, so on a
# t3.large (8 GB) 2-3 is sensible; raise with the instance size.
CELERY_CONCURRENCY=2
# Queues the main worker consumes. The "llm" queue has its own
# one-at-a-time worker (hms-celery-llm) — keep it out of this list.
CELERY_QUEUES=celery
CELERY_LOGLEVEL=INFO

# Flower dashboard login (user:password). Flower reads this itself.
# Required before exposing Flower through nginx; optional for SSH-tunnel use.
FLOWER_BASIC_AUTH=

# Only used by the optional hms-web.service (gunicorn): ~2 x vCPUs + 1.
GUNICORN_WORKERS=3
