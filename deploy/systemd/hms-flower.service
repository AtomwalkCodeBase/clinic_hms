# Flower — Celery monitoring dashboard. Optional: uploads keep working if it
# is down. Listens on 127.0.0.1 only (it shows task arguments); reach it via
# an SSH tunnel, or put it behind nginx + HTTPS with FLOWER_BASIC_AUTH set in
# /etc/hms/celery.env (Flower reads FLOWER_* environment variables itself).
[Unit]
Description=HMS Flower (Celery monitor)
After=network-online.target redis-server.service
Wants=network-online.target redis-server.service

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
Environment=DJANGO_SETTINGS_MODULE=atomwalk.settings.production
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/hms/celery.env
ExecStart=@APP_DIR@/venv/bin/celery -A atomwalk flower \
    --address=127.0.0.1 --port=5555 --max_tasks=10000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
